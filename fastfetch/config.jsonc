{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/cosmic.txt",
    "color": {
      "1": "38;2;46;49;37"
    },
    "padding": {
      "top": 3,
      "left": 2,
      "right": 6
    }
  },
  "display": {
    "separator": ": "
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;170;170;163m┌───────────────────────\u001b[38;2;117;78;62mHardware\u001b[38;2;170;170;163m───────────────────────┐"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "38;2;67;67;43"
    },
    {
      "type": "cpu",
      "key": "├ ",
      "keyColor": "38;2;67;67;43",
      "showPeCoreCount": true
    },
    {
      "type": "gpu",
      "key": "├ 󰢮",
      "keyColor": "38;2;67;67;43"
    },
    {
      "type": "display",
      "key": "├ 󰍹",
      "keyColor": "38;2;67;67;43"
    },
    {
      "type": "disk",
      "key": "├ ",
      "keyColor": "38;2;67;67;43",
      "folders": "/"
    },
    {
      "type": "memory",
      "key": "├ 󰍛",
      "keyColor": "38;2;67;67;43"
    },
    {
      "type": "swap",
      "key": "├ 󰓡",
      "keyColor": "38;2;67;67;43"
    },
    {
      "type": "battery",
      "key": "└ 󰁹",
      "keyColor": "38;2;67;67;43"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;170;170;163m└──────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;170;170;163m┌───────────────────────\u001b[38;2;117;78;62mSoftware\u001b[38;2;170;170;163m───────────────────────┐"
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "38;2;67;67;43",
      "format": "{name} {version-id}"
    },
    {
      "type": "de",
      "key": "├ ",
      "keyColor": "38;2;67;67;43"
    },
    {
      "type": "wm",
      "key": "├ ",
      "keyColor": "38;2;67;67;43"
    },
    {
      "type": "kernel",
      "key": "├ ",
      "keyColor": "38;2;67;67;43"
    },
    {
      "type": "shell",
      "key": "├ ",
      "keyColor": "38;2;67;67;43"
    },
    {
      "type": "terminal",
      "key": "├ ",
      "keyColor": "38;2;67;67;43"
    },
    {
      "type": "packages",
      "key": "├ 󰏖",
      "keyColor": "38;2;67;67;43"
    },
    {
      "type": "command",
      "key": "├ 󰏘",
      "keyColor": "38;2;67;67;43",
      "text": "echo -n 'Dossier '; for c in 36,36,36 149,59,25 81,87,59 117,78,62 168,0,38 67,67,43 89,87,77; do printf '\\033[38;2;%sm●' \"$(echo $c | tr , \\;)\"; done"
    },
    {
      "type": "terminalfont",
      "key": "└ ",
      "keyColor": "38;2;67;67;43"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;170;170;163m└──────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;170;170;163m┌────────────────\u001b[38;2;117;78;62mAge / Uptime / Update\u001b[38;2;170;170;163m─────────────────┐"
    },
    {
      "type": "command",
      "key": "󰔟 OS Age",
      "keyColor": "38;2;67;67;43",
      "text": "b=$(stat -c %W / 2>/dev/null); [ \"${b:-0}\" -le 0 ] && b=$(stat -c %Y /var/log/installer 2>/dev/null); echo \"$(( ($(date +%s) - b) / 86400 )) days\""
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "38;2;67;67;43"
    },
    {
      "type": "command",
      "key": "󰚰 Update",
      "keyColor": "38;2;67;67;43",
      "text": "d=$( { zcat -f /var/log/apt/history.log* 2>/dev/null; } | grep '^Start-Date' | sort | tail -1 | cut -d' ' -f2- ); [ -n \"$d\" ] && date -d \"$d\" '+%A, %B %d %Y at %H:%M' || echo unknown"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;170;170;163m└──────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
