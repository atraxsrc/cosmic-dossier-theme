# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#D0D0C8"

# Main text color
theme[main_fg]="#242424"

# Title color for boxes
theme[title]="#2E3125"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#DE6A41"

# Background color of selected item in processes box
theme[selected_bg]="#43432B"

# Foreground color of selected item in processes box
theme[selected_fg]="#D0D0C8"

# Color of inactive/disabled text
theme[inactive_fg]="#AAAAA3"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#953B19"

# Box outline and divider line color
theme[cpu_box]="#2E3125"
theme[mem_box]="#2E3125"
theme[net_box]="#2E3125"
theme[proc_box]="#2E3125"
theme[div_line]="#6B7360"

# Gradient for all meters and graphs: olive -> rust -> red
theme[temp_start]="#51573B"
theme[temp_mid]="#953B19"
theme[temp_end]="#A80026"


theme[cpu_start]="#51573B"
theme[cpu_mid]="#953B19"
theme[cpu_end]="#A80026"


theme[free_start]="#51573B"
theme[free_mid]="#953B19"
theme[free_end]="#A80026"


theme[cached_start]="#754E3E"
theme[cached_mid]="#754E3E"
theme[cached_end]="#754E3E"


theme[available_start]="#43432B"
theme[available_mid]="#43432B"
theme[available_end]="#43432B"


theme[used_start]="#A80026"
theme[used_mid]="#A80026"
theme[used_end]="#A80026"


theme[download_start]="#51573B"
theme[download_mid]="#953B19"
theme[download_end]="#A80026"


theme[upload_start]="#51573B"
theme[upload_mid]="#953B19"
theme[upload_end]="#A80026"
