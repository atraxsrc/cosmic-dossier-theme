# Dossier for Ghostty, part of cosmic-dossier-theme (MIT).
# Colours follow the COSMIC Terminal scheme (cosmic-term/).
#
# Install: ./ghostty/install.sh puts this in ~/.config/ghostty/themes/, then in
# ~/.config/ghostty/config:
#   theme = Dossier
# or, with the Noir half installed too, following COSMIC's Dark / Light toggle:
#   theme = dark:Noir,light:Dossier

